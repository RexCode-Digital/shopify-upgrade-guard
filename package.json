{
  "name": "shopify-upgrade-guard",
  "version": "0.2.0",
  "description": "Offline static analysis for Shopify platform and API upgrade risks.",
  "type": "module",
  "bin": {
    "shopify-upgrade-guard": "src/cli.js",
    "upgradeguard": "src/cli.js"
  },
  "files": [
    "src",
    "data",
    "action.yml",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "c8 --exclude 'dist/**' --exclude 'node_modules/**' --check-coverage --lines 90 --statements 90 --functions 85 --branches 85 --reporter=text --reporter=text-summary node --test",
    "lint": "node --check src/cli.js && node --check src/scan.js && node --check src/action.js",
    "build:action": "ncc build src/action.js -o dist --minify",
    "check:dist": "npm run build:action && git diff --exit-code -- dist/index.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/efegokdemir/shopify-upgrade-guard.git"
  },
  "bugs": {
    "url": "https://github.com/efegokdemir/shopify-upgrade-guard/issues"
  },
  "keywords": [
    "shopify",
    "shopify-api",
    "github-actions",
    "developer-tools",
    "migration",
    "deprecation"
  ],
  "publishConfig": {
    "provenance": true
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "c8": "^10.1.3"
  }
}
