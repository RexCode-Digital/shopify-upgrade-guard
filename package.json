{
  "name": "shopify-upgrade-guard",
  "version": "0.2.5",
  "description": "Check documented Shopify API and platform upgrade compatibility risks with an offline CLI and GitHub Action.",
  "type": "module",
  "bin": {
    "shopify-upgrade-guard": "src/cli.js",
    "upgradeguard": "src/cli.js"
  },
  "files": [
    "src",
    "data",
    "action.yml",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "c8 --include 'src/**' --check-coverage --lines 90 --statements 90 --functions 85 --branches 85 --reporter=text --reporter=text-summary --reporter=json-summary node --test",
    "lint": "node scripts/check-source.mjs",
    "build:action": "ncc build src/action.js -o dist --minify --license licenses.txt",
    "check:dist": "npm run build:action && git diff --exit-code -- dist/index.js dist/licenses.txt",
    "pack:check": "npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.mjs",
    "action:check": "node scripts/check-action.mjs",
    "prebuild:action": "node scripts/write-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RexCode-Digital/shopify-upgrade-guard.git"
  },
  "bugs": {
    "url": "https://github.com/RexCode-Digital/shopify-upgrade-guard/issues"
  },
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-api",
    "upgrade",
    "migration",
    "compatibility",
    "github-actions",
    "ci"
  ],
  "publishConfig": {
    "provenance": true
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "c8": "12.0.0"
  },
  "dependencies": {
    "graphql": "16.14.2"
  },
  "homepage": "https://github.com/RexCode-Digital/shopify-upgrade-guard#readme"
}
